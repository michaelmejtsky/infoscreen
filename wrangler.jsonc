{
  "name": "infoscreen",
  "compatibility_date": "2026-11-20",
  "main": "src/worker.js",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "none"
  },
  "vars": {
    "BAZ4_DEMO": "true"
  }
}
